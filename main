        <div 
          className="rounded-3xl border p-6 sm:p-10 backdrop-blur-md transition-all shadow-xl"
          style={{
            backgroundColor: theme.colors.cardBg,
            borderColor: theme.colors.border
          }}
        >
          {rsvpSuccess ? (
            <div className="text-center py-12 px-4 space-y-4">
              <div 
