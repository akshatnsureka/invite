                      </span>
                      <span className="text-xs flex items-center gap-1.5 opacity-80" style={{ color: theme.colors.textMuted }}>
                        <Clock className="w-3.5 h-3.5" style={{ color: theme.colors.primary }} />
                        {item.time}
                      </span>
                    </div>

                    <h3 className="text-xl font-serif font-medium mb-1" style={{ color: theme.colors.accent }}>
                      {item.title}
                    </h3>
                    <p className="text-xs font-light mb-3 flex items-center gap-1" style={{ color: theme.colors.primary }}>
                      <MapPin className="w-3.5 h-3.5 shrink-0" />
                      {item.venue}
                    </p>

                    <p className="text-sm font-light leading-relaxed mb-4" style={{ color: theme.colors.textMuted }}>
                      {item.description}
                    </p>

                    {/* Dress Code & Palette Swatches */}
                    <div className="pt-3 border-t flex flex-wrap items-center justify-between gap-3 text-xs" style={{ borderColor: theme.colors.border }}>
                      <div>
                        <span className="block text-[10px] uppercase tracking-wider opacity-60">Dress Attire:</span>
                        <span className="font-medium" style={{ color: theme.colors.accent }}>{item.dressCode}</span>
                      </div>

                      <div className="flex items-center gap-1.5">
                        <span className="text-[10px] uppercase tracking-wider opacity-60 mr-1">Tones:</span>
