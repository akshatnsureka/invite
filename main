                      rsvpForm.attending === 'yes' ? 'ring-1' : 'opacity-60'
                    }`}
                    style={{
                      borderColor: theme.colors.border,
                      backgroundColor: rsvpForm.attending === 'yes' ? theme.colors.primary : 'transparent',
                      color: rsvpForm.attending === 'yes' ? theme.colors.primaryText : theme.colors.textMain
                    }}
                  >
                    <Check className="w-4 h-4" />
