                          {num} {num === 1 ? 'Guest' : 'Guests'}
                        </option>
                      ))}
                    </select>
                  </div>

                  {/* Dietary Preferences */}
                  <div>
                    <label className="block text-xs uppercase tracking-wider mb-2 font-medium" style={{ color: theme.colors.accent }}>
