                          <div 
                            key={i} 
                            className="w-4 h-4 rounded-full border border-black/30 shadow-sm"
                            style={{ backgroundColor: color }}
                            title={color}
                          />
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      {}
      <section className="py-20 px-4 max-w-5xl mx-auto relative z-10" id="venue">
        <div className="text-center mb-12">
          <p className="text-xs uppercase tracking-[0.3em] font-semibold mb-2" style={{ color: theme.colors.primary }}>
