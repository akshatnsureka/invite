                      rsvpForm.attending === 'no' ? 'ring-1' : 'opacity-60'
                    }`}
                    style={{
                      borderColor: theme.colors.border,
                      backgroundColor: rsvpForm.attending === 'no' ? `${theme.colors.surfaceLight}cc` : 'transparent',
                      color: theme.colors.textMain
                    }}
                  >
                    <X className="w-4 h-4" />
                    Regretfully Decline
                  </button>
                </div>
              </div>

              {rsvpForm.attending === 'yes' && (
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
