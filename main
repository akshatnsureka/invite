                  <div>
                    <span className="font-medium" style={{ color: theme.colors.accent }}>{entry.guestName}</span>
                    <span className="opacity-60 ml-2">({entry.guestCount} {entry.guestCount > 1 ? 'attendees' : 'attendee'})</span>
                    {entry.message && <p className="text-[11px] italic opacity-75 mt-0.5 line-clamp-1">"{entry.message}"</p>}
                  </div>
                  <span className="text-[10px] uppercase font-semibold px-2 py-0.5 rounded"
                    style={{
                      backgroundColor: entry.attending === 'yes' ? `${theme.colors.primary}30` : 'rgba(255,255,255,0.1)',
                      color: entry.attending === 'yes' ? theme.colors.primary : '#ccc'
