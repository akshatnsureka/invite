                {/* Pin Center Marker */}
                <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div className="relative flex flex-col items-center">
                    <div 
                      className="px-3 py-1.5 rounded-lg text-xs font-medium shadow-xl border mb-1 flex items-center gap-1.5 backdrop-blur-md"
                      style={{
                        backgroundColor: theme.colors.surface,
                        borderColor: theme.colors.primary,
                        color: theme.colors.accent
                      }}
                    >
                      <MapPin className="w-3.5 h-3.5" style={{ color: theme.colors.primary }} />
                      The Oberoi Udaivilas
                    </div>
                    <div className="w-3 h-3 rotate-45 -mt-2.5" style={{ backgroundColor: theme.colors.surface }} />
                  </div>
                </div>

                <div className="absolute bottom-3 right-3">
                  <a
                    href={eventDetails.googleMapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="text-[11px] px-3 py-1.5 rounded-md backdrop-blur-md bg-black/60 border hover:bg-black/90 flex items-center gap-1 transition-all"
