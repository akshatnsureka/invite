              >
                <CheckCircle2 className="w-8 h-8" style={{ color: theme.colors.primary }} />
              </div>
              <h3 className="text-2xl font-serif" style={{ color: theme.colors.accent }}>
                Thank You, {rsvpForm.guestName}!
              </h3>
              <p className="text-sm max-w-md mx-auto leading-relaxed" style={{ color: theme.colors.textMuted }}>
                {rsvpForm.attending === 'yes'
                  ? `Your confirmation for ${rsvpForm.guestCount} guest(s) has been preserved. We eagerly await welcoming you in Udaipur!`
                  : `We are truly touched by your warm wishes and will deeply miss having you celebrate in person.`}
              </p>
              <button
                onClick={() => setRsvpSuccess(false)}
                className="mt-4 px-6 py-2 rounded-full text-xs font-medium border transition-colors hover:bg-white/10"
                style={{ borderColor: theme.colors.border, color: theme.colors.primary }}
