                      style={{ borderColor: theme.colors.border, color: theme.colors.textMain }}
                    >
                      <option value="Vegetarian" className="bg-slate-900 text-white">Pure Vegetarian</option>
                      <option value="Jain Vegetarian" className="bg-slate-900 text-white">Jain Vegetarian</option>
                      <option value="Non-Vegetarian" className="bg-slate-900 text-white">Non-Vegetarian</option>
                      <option value="Vegan" className="bg-slate-900 text-white">Vegan</option>
                      <option value="Gluten-Free" className="bg-slate-900 text-white">Gluten-Free</option>
                    </select>
