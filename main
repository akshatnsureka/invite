      {}
      <section className="py-20 px-4 max-w-4xl mx-auto relative z-10" id="rsvp">
        <div className="text-center mb-12">
          <p className="text-xs uppercase tracking-[0.3em] font-semibold mb-2" style={{ color: theme.colors.primary }}>
            Join The Rejoicing
          </p>
          <h2 className="text-3xl sm:text-4xl font-serif" style={{ color: theme.colors.accent }}>
            Kindly Confirm Your RSVP
          </h2>
          <p className="text-xs sm:text-sm mt-2 opacity-75" style={{ color: theme.colors.textMuted }}>
