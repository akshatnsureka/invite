function triggerConfettiAnimation(canvas) {
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const count = 120;
  const pieces = [];
  const colors = ['#d4af37', '#f3e5ab', '#e09f83', '#ffffff', '#b0c4de', '#f4b6c1'];

  for (let i = 0; i < count; i++) {
    pieces.push({
      x: canvas.width / 2,
      y: canvas.height / 2,
      vx: (Math.random() - 0.5) * 16,
      vy: (Math.random() - 0.7) * 18,
      size: Math.random() * 8 + 4,
      color: colors[Math.floor(Math.random() * colors.length)],
      rotation: Math.random() * 360,
      vRot: (Math.random() - 0.5) * 12,
      opacity: 1
    });
  }

  let animationFrame;
  let frames = 0;

  function render() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    let activePieces = 0;

    pieces.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.35; // gravity
      p.vx *= 0.98; // drag
      p.rotation += p.vRot;
      if (frames > 40) {
        p.opacity -= 0.015;
      }

      if (p.opacity > 0) {
        activePieces++;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rotation * Math.PI) / 180);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = Math.max(0, p.opacity);
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.7);
        ctx.restore();
      }
    });

    frames++;
    if (activePieces > 0 && frames < 180) {
      animationFrame = requestAnimationFrame(render);
    } else {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
  }

  render();
}

export default function App() {
  // Theme state
  const [currentThemeKey, setCurrentThemeKey] = useState('royal');
  const theme = THEME_PRESETS[currentThemeKey];

  // Event config details (Easily editable here)
  const eventDetails = {
    hosts: 'Ananya & Kabir',
    tagline: 'Together With Their Families Invite You To Celebrate Their Union',
    dateIso: '2026-11-20T18:30:00+05:30',
    displayDate: 'November 20 - 21, 2026',
    venueName: 'The Oberoi Udaivilas Palace',
    venueCity: 'Udaipur, Rajasthan, India',
    coordinates: { lat: 24.5772, lng: 73.6738 },
    googleMapUrl: 'https://maps.google.com/?q=The+Oberoi+Udaivilas+Udaipur',
    appleMapUrl: 'http://maps.apple.com/?daddr=24.5772,73.6738',
    uberIntentUrl: 'https://m.uber.com/ul/?action=setPickup&pickup=my_location&dropoff[latitude]=24.5772&dropoff[longitude]=73.6738&dropoff[nickname]=The+Oberoi+Udaivilas',
    olaIntentUrl: 'https://book.olacabs.com/?lat=24.5772&lng=73.6738'
  };

  // Countdown State
  const [timeLeft, setTimeLeft] = useState({ days: 0, hours: 0, minutes: 0, seconds: 0 });

  useEffect(() => {
    const targetDate = new Date(eventDetails.dateIso).getTime();

    const updateCountdown = () => {
      const now = new Date().getTime();
      const difference = targetDate - now;

      if (difference <= 0) {
        setTimeLeft({ days: 0, hours: 0, minutes: 0, seconds: 0 });
        return;
      }

      setTimeLeft({
        days: Math.floor(difference / (1000 * 60 * 60 * 24)),
        hours: Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)),
        minutes: Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60)),
        seconds: Math.floor((difference % (1000 * 60)) / 1000)
      });
    };

    updateCountdown();
    const timer = setInterval(updateCountdown, 1000);
    return () => clearInterval(timer);
  }, [eventDetails.dateIso]);

  const [isPlayingAudio, setIsPlayingAudio] = useState(false);
  const audioRef = useRef(null);

  const toggleAudio = () => {
    if (!audioRef.current) return;
    if (isPlayingAudio) {
      audioRef.current.pause();
      setIsPlayingAudio(false);
    } else {
      audioRef.current.play().then(() => {
        setIsPlayingAudio(true);
      }).catch(err => {
        console.warn('Audio autoplay or playback requires user interaction:', err);
      });
    }
  };

  const [rsvpForm, setRsvpForm] = useState({
    guestName: '',
    phone: '',
    attending: 'yes',
    guestCount: 1,
    dietary: 'Vegetarian',
    message: ''
  });
  const [rsvpSubmitting, setRsvpSubmitting] = useState(false);
  const [rsvpSuccess, setRsvpSuccess] = useState(false);
  const [storedRsvps, setStoredRsvps] = useState([
    {
      id: 'mock-1',
      guestName: 'Rohit & Natasha Verma',
      phone: '+91 98765 43210',
      attending: 'yes',
      guestCount: 2,
      dietary: 'Vegetarian',
      message: 'So incredibly thrilled for you both! Cannot wait to dance under the Udaipur stars!',
      createdAt: 'Yesterday'
    }
  ]);
  const confettiCanvasRef = useRef(null);

  const handleRsvpSubmit = (e) => {
    e.preventDefault();
    if (!rsvpForm.guestName.trim()) return;

    setRsvpSubmitting(true);
    // Simulate persistent backend (e.g. Supabase insert)
    setTimeout(() => {
      const newEntry = {
        id: 'rsvp-' + Date.now(),
        ...rsvpForm,
        createdAt: 'Just now'
      };
      setStoredRsvps(prev => [newEntry, ...prev]);
      setRsvpSubmitting(false);
      setRsvpSuccess(true);

      // Trigger Confetti explosion
      if (confettiCanvasRef.current) {
        triggerConfettiAnimation(confettiCanvasRef.current);
      }
    }, 700);
  };

  const [photoPhase, setPhotoPhase] = useState('during'); // 'before' | 'during' | 'after'
  const [photos, setPhotos] = useState(INITIAL_PHOTOS);
  const [isUploadDrawerOpen, setIsUploadDrawerOpen] = useState(false);
  const [lightboxPhoto, setLightboxPhoto] = useState(null);
  const [newUploadFile, setNewUploadFile] = useState(null);
  const [newUploadPreview, setNewUploadPreview] = useState(null);
  const [newUploadCaption, setNewUploadCaption] = useState('');
  const [newUploadName, setNewUploadName] = useState('');
  const [isUploading, setIsUploading] = useState(false);

  // Schema Drawer Modal State
  const [isSchemaModalOpen, setIsSchemaModalOpen] = useState(false);

  // Filtered photos by phase
  const filteredPhotos = useMemo(() => {
    return photos.filter(p => p.phase === photoPhase);
  }, [photos, photoPhase]);

  // Handle local image file drag/drop or pick
  const handlePhotoSelect = (e) => {
    const file = e.target.files?.[0];
    if (file) {
      setNewUploadFile(file);
      const objectUrl = URL.createObjectURL(file);
      setNewUploadPreview(objectUrl);
    }
  };

  const handleUploadSubmit = (e) => {
    e.preventDefault();
    if (!newUploadPreview) return;

    setIsUploading(true);
    setTimeout(() => {
      const newPhoto = {
        id: 'upload-' + Date.now(),
        phase: photoPhase,
        url: newUploadPreview,
        caption: newUploadCaption.trim() || 'A cherished celebration memory',
        uploadedBy: newUploadName.trim() || 'Valued Guest',
        likes: 1,
        createdAt: 'Just now'
      };

      setPhotos(prev => [newPhoto, ...prev]);
      setIsUploading(false);
      setIsUploadDrawerOpen(false);
      setNewUploadFile(null);
      setNewUploadPreview(null);
      setNewUploadCaption('');
      setNewUploadName('');
    }, 600);
  };

  const generateIcsFile = () => {
    const icsContent = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Luxury Event Portal//EN',
      'BEGIN:VEVENT',
      'UID:wedding-ananya-kabir-2026@celebration.portal',
      'DTSTAMP:20260101T000000Z',
      'DTSTART:20261120T130000Z',
      'DTEND:20261121T210000Z',
      `SUMMARY:Wedding Celebrations: ${eventDetails.hosts}`,
      `DESCRIPTION:Join us to celebrate ${eventDetails.hosts} at ${eventDetails.venueName}.`,
      `LOCATION:${eventDetails.venueName}, ${eventDetails.venueCity}`,
      'STATUS:CONFIRMED',
      'END:VEVENT',
      'END:VCALENDAR'
    ].join('\r\n');

    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
    const link = document.createElement('a');
    link.href = window.URL.createObjectURL(blob);
    link.setAttribute('download', 'Ananya_Kabir_Wedding_Invite.ics');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const openGoogleCalendar = () => {
    const title = encodeURIComponent(`Wedding Celebrations: ${eventDetails.hosts}`);
    const details = encodeURIComponent(`Grand wedding celebration of ${eventDetails.hosts} at ${eventDetails.venueName}.`);
    const location = encodeURIComponent(`${eventDetails.venueName}, ${eventDetails.venueCity}`);
    const dates = '20261120T130000Z/20261121T210000Z';
    const gCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${dates}&details=${details}&location=${location}`;
    window.open(gCalUrl, '_blank');
  };

  return (
    <div 
      className={`min-h-screen text-slate-100 selection:bg-amber-400 selection:text-slate-900 transition-colors duration-500 ${theme.fontBody}`}
      style={{
        backgroundColor: theme.colors.bg,
        color: theme.colors.textMain
      }}
    >
      {/* Background Ambience Ambient Glow */}
      <div 
        className="fixed inset-0 pointer-events-none opacity-25 z-0"
        style={{
          backgroundImage: `radial-gradient(circle at 50% 15%, ${theme.colors.primary} 0%, transparent 50%), radial-gradient(circle at 90% 75%, ${theme.colors.border} 0%, transparent 40%)`
        }}
      />

      {/* Floating Canvas for Confetti */}
      <canvas 
        ref={confettiCanvasRef}
        width={window.innerWidth || 1000}
        height={window.innerHeight || 800}
        className="fixed inset-0 pointer-events-none z-50 w-full h-full"
      />

      {/* Audio Element (Royalty-free romantic acoustic loops simulation) */}
      <audio 
        ref={audioRef} 
        loop 
        src="https://cdn.freesound.org/previews/568/568169_11861866-lq.mp3" 
        preload="none"
      />

      {/* STICKY TOP BAR: Theme Switcher & Admin Schema Access */}
      <header className="sticky top-0 z-40 backdrop-blur-md border-b px-4 py-3 flex items-center justify-between"
        style={{
          backgroundColor: `${theme.colors.surface}cc`,
          borderColor: theme.colors.border
        }}
      >
        <div className="flex items-center space-x-2">
          <div 
            className="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs shadow-inner"
            style={{ backgroundColor: theme.colors.primary, color: theme.colors.primaryText }}
          >
            A&K
          </div>
          <span className="text-xs uppercase tracking-widest font-semibold hidden sm:inline" style={{ color: theme.colors.primary }}>
            Royal Guest Portal
          </span>
        </div>

        {/* Action Controls */}
        <div className="flex items-center space-x-2 sm:space-x-4">
          {/* Theme Presets Dropdown */}
          <div className="flex items-center space-x-1.5 bg-black/40 border rounded-full px-2.5 py-1 text-xs" style={{ borderColor: theme.colors.border }}>
            <Palette className="w-3.5 h-3.5" style={{ color: theme.colors.primary }} />
            <span className="text-[11px] text-gray-400 hidden md:inline">Theme:</span>
            <select
              value={currentThemeKey}
              onChange={(e) => setCurrentThemeKey(e.target.value)}
              className="bg-transparent text-xs font-medium focus:outline-none cursor-pointer pr-1"
              style={{ color: theme.colors.accent }}
            >
              {Object.entries(THEME_PRESETS).map(([key, item]) => (
                <option key={key} value={key} className="bg-slate-900 text-white">
                  {item.name}
                </option>
              ))}
            </select>
          </div>

          {/* Database Setup Button */}
          <button
            onClick={() => setIsSchemaModalOpen(true)}
            className="flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-medium transition-all hover:scale-105 border"
            style={{ 
              borderColor: theme.colors.border,
              backgroundColor: `${theme.colors.surfaceLight}90`,
              color: theme.colors.primary
            }}
            title="View backend SQL Schema & Instructions"
          >
            <Code2 className="w-3.5 h-3.5" />
            <span className="hidden sm:inline">Backend Schema</span>
          </button>
        </div>
      </header>

      {}
      <section className="relative min-h-[92vh] flex flex-col items-center justify-center text-center px-4 py-16 overflow-hidden">
        {/* Subtle Ornamental Frame */}
        <div 
          className="max-w-4xl mx-auto p-8 sm:p-12 md:p-16 rounded-3xl relative border backdrop-blur-md transition-all duration-700"
          style={{
            backgroundColor: theme.colors.cardBg,
            borderColor: theme.colors.border,
            boxShadow: theme.colors.goldGlow
          }}
        >
          {/* Top Monogram */}
          <div className="flex justify-center mb-6">
            <div 
              className="w-16 h-16 rounded-full border flex items-center justify-center relative p-3"
              style={{ borderColor: theme.colors.primary }}
            >
              <Heart className="w-7 h-7 stroke-1" style={{ color: theme.colors.primary }} />
              <div 
                className="absolute inset-0 rounded-full animate-ping opacity-20 pointer-events-none"
                style={{ backgroundColor: theme.colors.primary }}
              />
            </div>
          </div>

          <p className="text-xs sm:text-sm tracking-[0.35em] uppercase mb-4" style={{ color: theme.colors.primary }}>
            Save The Date & Interactive Invitation
          </p>

          <h1 
            className={`text-4xl sm:text-6xl md:text-7xl tracking-wide mb-6 font-serif ${theme.fontHeading}`}
            style={{ color: theme.colors.accent }}
          >
            {eventDetails.hosts}
          </h1>

          <p className="text-sm sm:text-base max-w-xl mx-auto font-light leading-relaxed mb-8" style={{ color: theme.colors.textMuted }}>
            {eventDetails.tagline}
          </p>

          {/* Date & Location Pill */}
          <div className="inline-flex flex-wrap items-center justify-center gap-3 sm:gap-6 py-2.5 px-6 rounded-full border mb-10 text-xs sm:text-sm font-light"
            style={{ 
              borderColor: theme.colors.border,
              backgroundColor: 'rgba(0,0,0,0.3)'
            }}
          >
            <span className="flex items-center gap-2">
              <Calendar className="w-4 h-4" style={{ color: theme.colors.primary }} />
              {eventDetails.displayDate}
            </span>
            <span className="hidden sm:inline opacity-30">•</span>
            <span className="flex items-center gap-2">
              <MapPin className="w-4 h-4" style={{ color: theme.colors.primary }} />
              {eventDetails.venueCity}
            </span>
          </div>

          {/* Live Countdown Display */}
          <div className="mb-10">
            <p className="text-xs uppercase tracking-widest mb-4 opacity-80" style={{ color: theme.colors.primary }}>
              The Celebration Begins In
            </p>
            <div className="grid grid-cols-4 gap-2 sm:gap-4 max-w-md mx-auto">
              {[
                { label: 'Days', val: timeLeft.days },
                { label: 'Hours', val: timeLeft.hours },
                { label: 'Minutes', val: timeLeft.minutes },
                { label: 'Seconds', val: timeLeft.seconds }
              ].map((unit, idx) => (
                <div 
                  key={idx} 
                  className="p-3 sm:p-4 rounded-xl border flex flex-col items-center justify-center"
                  style={{
                    backgroundColor: 'rgba(0,0,0,0.4)',
                    borderColor: theme.colors.border
                  }}
                >
                  <span className="text-2xl sm:text-4xl font-serif font-medium" style={{ color: theme.colors.accent }}>
                    {String(unit.val).padStart(2, '0')}
                  </span>
                  <span className="text-[10px] sm:text-xs tracking-wider uppercase mt-1 opacity-75">
                    {unit.label}
                  </span>
                </div>
              ))}
            </div>
          </div>

          {/* Quick Action Buttons */}
          <div className="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
            <button
              onClick={openGoogleCalendar}
              className="px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition-all transform hover:-translate-y-0.5 flex items-center gap-2 shadow-lg"
              style={{
                backgroundColor: theme.colors.primary,
                color: theme.colors.primaryText
              }}
            >
              <Calendar className="w-4 h-4" />
              Add to Google Calendar
            </button>
            <button
              onClick={generateIcsFile}
              className="px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition-all border hover:bg-white/10 flex items-center gap-2"
              style={{
                borderColor: theme.colors.border,
                color: theme.colors.textMain
              }}
            >
              <Download className="w-4 h-4" style={{ color: theme.colors.primary }} />
              Download .ICS (Apple)
            </button>
          </div>
        </div>
      </section>

      {}
      <section className="py-20 px-4 max-w-5xl mx-auto relative z-10" id="itinerary">
        <div className="text-center mb-14">
          <p className="text-xs uppercase tracking-[0.3em] font-semibold mb-2" style={{ color: theme.colors.primary }}>
