      {}
      <section className="py-20 px-4 max-w-6xl mx-auto relative z-10" id="gallery">
        <div className="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
          <div>
            <p className="text-xs uppercase tracking-[0.3em] font-semibold mb-2" style={{ color: theme.colors.primary }}>
              The Visual Story
            </p>
            <h2 className="text-3xl sm:text-4xl font-serif" style={{ color: theme.colors.accent }}>
              Interactive Photo Hub
            </h2>
            <p className="text-xs sm:text-sm mt-1.5 opacity-75" style={{ color: theme.colors.textMuted }}>
              Curated shoots, candid live stream uploads, and official post-event highlights
            </p>
          </div>

          {/* Guest Action: Open Upload Drawer */}
          <button
            onClick={() => setIsUploadDrawerOpen(true)}
            className="px-5 py-3 rounded-full text-xs font-semibold tracking-wider uppercase transition-all flex items-center gap-2 shadow-lg self-start md:self-auto"
            style={{
              backgroundColor: theme.colors.primary,
              color: theme.colors.primaryText
            }}
          >
            <Camera className="w-4 h-4" />
            Upload Guest Snapshot
          </button>
        </div>

        {/* Phase Tabs Selector */}
        <div className="flex items-center gap-2 border-b pb-4 mb-8 overflow-x-auto" style={{ borderColor: theme.colors.border }}>
          {[
            { id: 'before', label: '1. Pre-Event Shoot', tag: 'Engagement & Teasers' },
            { id: 'during', label: '2. Live Celebration', tag: 'Guest Live Stream' },
            { id: 'after', label: '3. Official Highlights', tag: 'Post-Event Gallery' }
          ].map(tab => (
            <button
              key={tab.id}
              onClick={() => setPhotoPhase(tab.id)}
              className={`px-4 py-2.5 rounded-xl text-xs font-medium transition-all flex flex-col items-start whitespace-nowrap border ${
                photoPhase === tab.id ? 'shadow-md' : 'opacity-60 hover:opacity-100'
              }`}
              style={{
                borderColor: photoPhase === tab.id ? theme.colors.primary : 'transparent',
                backgroundColor: photoPhase === tab.id ? `${theme.colors.surfaceLight}cc` : 'transparent',
                color: photoPhase === tab.id ? theme.colors.accent : theme.colors.textMuted
              }}
            >
              <span className="font-semibold">{tab.label}</span>
              <span className="text-[10px] opacity-70">{tab.tag}</span>
            </button>
          ))}
        </div>

        {/* Masonry / Fluid Responsive Grid */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredPhotos.map((item) => (
            <div 
              key={item.id} 
              className="group relative rounded-2xl border overflow-hidden cursor-pointer backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
              style={{
                backgroundColor: theme.colors.cardBg,
                borderColor: theme.colors.border
              }}
              onClick={() => setLightboxPhoto(item)}
            >
              <div className="aspect-[4/5] w-full overflow-hidden relative">
                <img 
                  src={item.url} 
                  alt={item.caption}
                  className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 opacity-70 group-hover:opacity-90 transition-opacity" />

                {/* Corner Phase Badge */}
                <span className="absolute top-3 left-3 text-[10px] tracking-widest uppercase font-semibold px-2 py-0.5 rounded backdrop-blur-md bg-black/60 border border-white/10" style={{ color: theme.colors.primary }}>
                  {item.phase}
                </span>

                {/* Details Footer */}
                <div className="absolute bottom-3 left-3 right-3 text-white">
                  <p className="text-xs font-medium line-clamp-2 mb-1" style={{ color: theme.colors.accent }}>
                    {item.caption}
                  </p>
                  <div className="flex items-center justify-between text-[11px] opacity-75">
                    <span>by {item.uploadedBy}</span>
                    <span className="flex items-center gap-1">
                      <Heart className="w-3 h-3 fill-rose-500 text-rose-500" />
                      {item.likes}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        {filteredPhotos.length === 0 && (
          <div className="text-center py-16 border rounded-2xl" style={{ borderColor: theme.colors.border }}>
            <Camera className="w-10 h-10 mx-auto opacity-40 mb-3" />
            <p className="text-sm font-light" style={{ color: theme.colors.textMuted }}>No photographs uploaded in this phase yet.</p>
            <button
              onClick={() => setIsUploadDrawerOpen(true)}
              className="mt-3 text-xs underline font-medium"
              style={{ color: theme.colors.primary }}
            >
              Be the first to upload a snapshot
            </button>
          </div>
        )}
      </section>

      {}
      {lightboxPhoto && (
        <div className="fixed inset-0 z-50 bg-black/95 backdrop-blur-xl flex items-center justify-center p-4">
          <button 
            onClick={() => setLightboxPhoto(null)}
            className="absolute top-6 right-6 p-2 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
          >
            <X className="w-6 h-6" />
          </button>

          <div className="max-w-4xl w-full flex flex-col items-center">
            <div className="max-h-[75vh] w-auto overflow-hidden rounded-2xl border border-white/20 mb-4 shadow-2xl">
              <img 
                src={lightboxPhoto.url} 
                alt={lightboxPhoto.caption}
                className="max-h-[75vh] max-w-full object-contain"
              />
            </div>
            <div className="w-full flex items-center justify-between text-white/90 text-sm px-2">
              <div>
                <p className="font-serif text-base">{lightboxPhoto.caption}</p>
                <p className="text-xs text-white/60">Uploaded by {lightboxPhoto.uploadedBy} • {lightboxPhoto.createdAt}</p>
              </div>

              <a
                href={lightboxPhoto.url}
                download="wedding-memory.jpg"
                target="_blank"
                rel="noreferrer"
                className="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-medium border border-white/30 hover:bg-white/10"
              >
                <Download className="w-4 h-4" />
                Download Original
              </a>
            </div>
          </div>
        </div>
      )}

      {}
      {isUploadDrawerOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex justify-end">
          <div 
            className="w-full max-w-md h-full overflow-y-auto p-6 sm:p-8 border-l flex flex-col justify-between"
            style={{
              backgroundColor: theme.colors.surface,
              borderColor: theme.colors.border
            }}
          >
            <div>
              <div className="flex items-center justify-between pb-4 border-b mb-6" style={{ borderColor: theme.colors.border }}>
                <div className="flex items-center gap-2">
                  <Camera className="w-5 h-5" style={{ color: theme.colors.primary }} />
                  <h3 className="text-lg font-serif" style={{ color: theme.colors.accent }}>Contribute Photo</h3>
                </div>
                <button 
                  onClick={() => setIsUploadDrawerOpen(false)}
                  className="p-1 rounded-full text-stone-400 hover:text-white"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              <form onSubmit={handleUploadSubmit} className="space-y-5">
                {/* File Dropzone Area */}
                <div>
                  <label className="block text-xs uppercase tracking-wider mb-2 font-medium" style={{ color: theme.colors.accent }}>
                    Select Image (Camera or Gallery) *
                  </label>
                  <label 
                    className="border-2 border-dashed rounded-2xl p-6 flex flex-col items-center justify-center text-center cursor-pointer transition-all hover:bg-black/20"
                    style={{ borderColor: theme.colors.border }}
                  >
                    {newUploadPreview ? (
                      <div className="relative w-full aspect-video rounded-xl overflow-hidden">
                        <img src={newUploadPreview} alt="Preview" className="w-full h-full object-cover" />
                        <span className="absolute bottom-2 right-2 text-[10px] px-2 py-0.5 rounded bg-black/70 text-white">
                          Change Image
                        </span>
                      </div>
                    ) : (
                      <>
                        <Upload className="w-8 h-8 opacity-50 mb-2" style={{ color: theme.colors.primary }} />
                        <p className="text-xs font-medium" style={{ color: theme.colors.accent }}>Tap to select from Smartphone</p>
                        <p className="text-[10px] text-gray-400 mt-1">JPEG, PNG, HEIC up to 25MB</p>
                      </>
                    )}
                    <input 
                      type="file" 
                      accept="image/*" 
                      onChange={handlePhotoSelect} 
                      className="hidden" 
                    />
                  </label>
                </div>

                {/* Uploader Name */}
                <div>
                  <label className="block text-xs uppercase tracking-wider mb-2 font-medium" style={{ color: theme.colors.accent }}>
                    Your Name
                  </label>
                  <input
                    type="text"
                    placeholder="e.g. Rohini Shah"
                    value={newUploadName}
                    onChange={(e) => setNewUploadName(e.target.value)}
                    className="w-full px-4 py-2.5 rounded-xl border bg-black/30 text-xs focus:outline-none"
                    style={{ borderColor: theme.colors.border, color: theme.colors.textMain }}
                  />
                </div>

                {/* Caption */}
                <div>
                  <label className="block text-xs uppercase tracking-wider mb-2 font-medium" style={{ color: theme.colors.accent }}>
                    Caption / Memory
                  </label>
                  <input
                    type="text"
                    placeholder="e.g. Sangeet dance practice behind the scenes!"
                    value={newUploadCaption}
                    onChange={(e) => setNewUploadCaption(e.target.value)}
                    className="w-full px-4 py-2.5 rounded-xl border bg-black/30 text-xs focus:outline-none"
                    style={{ borderColor: theme.colors.border, color: theme.colors.textMain }}
                  />
                </div>

                {/* Phase Selection */}
                <div>
                  <label className="block text-xs uppercase tracking-wider mb-2 font-medium" style={{ color: theme.colors.accent }}>
                    Target Phase Tab
                  </label>
                  <div className="grid grid-cols-3 gap-2 text-xs">
                    {['before', 'during', 'after'].map(p => (
                      <button
                        type="button"
                        key={p}
                        onClick={() => setPhotoPhase(p)}
                        className={`py-2 rounded-lg border capitalize text-[11px] ${photoPhase === p ? 'font-bold' : 'opacity-60'}`}
                        style={{
                          borderColor: theme.colors.border,
                          backgroundColor: photoPhase === p ? theme.colors.primary : 'transparent',
                          color: photoPhase === p ? theme.colors.primaryText : theme.colors.textMain
                        }}
                      >
                        {p}
                      </button>
                    ))}
                  </div>
                </div>

                <div className="p-3 rounded-xl border bg-black/20 text-[11px] text-gray-300 flex items-start gap-2" style={{ borderColor: theme.colors.border }}>
                  <Info className="w-4 h-4 shrink-0 mt-0.5" style={{ color: theme.colors.primary }} />
                  <span>Photos will be instantly added to the live gallery stream with automatic moderation safety flag.</span>
                </div>

                <button
                  type="submit"
                  disabled={!newUploadPreview || isUploading}
                  className="w-full py-3.5 rounded-xl text-xs font-semibold tracking-wider uppercase transition-all shadow-md flex items-center justify-center gap-2 disabled:opacity-50"
                  style={{
                    backgroundColor: theme.colors.primary,
                    color: theme.colors.primaryText
                  }}
                >
                  {isUploading ? (
                    <span>Uploading Snapshot...</span>
                  ) : (
                    <>
                      <Upload className="w-4 h-4" />
                      Publish to Portal Gallery
                    </>
                  )}
                </button>
              </form>
            </div>

            <div className="pt-6 text-center text-[10px] text-gray-400">
              Preserved in Supabase Bucket `event-photos`
            </div>
          </div>
        </div>
      )}

      {}
      {isSchemaModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
          <div 
            className="max-w-2xl w-full rounded-2xl border p-6 sm:p-8 max-h-[85vh] overflow-y-auto"
            style={{
              backgroundColor: theme.colors.surface,
              borderColor: theme.colors.border
            }}
          >
            <div className="flex items-center justify-between pb-4 border-b mb-6" style={{ borderColor: theme.colors.border }}>
              <div className="flex items-center gap-2">
                <Code2 className="w-5 h-5" style={{ color: theme.colors.primary }} />
                <h3 className="text-xl font-serif" style={{ color: theme.colors.accent }}>Supabase & Backend Setup</h3>
              </div>
              <button 
                onClick={() => setIsSchemaModalOpen(false)}
                className="p-1 rounded-full text-stone-400 hover:text-white"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="space-y-4 text-xs leading-relaxed text-gray-300">
              <p>
                To connect this frontend to a real live PostgreSQL instance on <strong>Supabase</strong>, navigate to your Supabase SQL Editor and execute this single schema script:
              </p>

              <div className="p-4 rounded-xl bg-black/60 border font-mono text-[11px] overflow-x-auto text-emerald-300 selection:bg-emerald-800" style={{ borderColor: theme.colors.border }}>
                <pre>{`-- 1. Create RSVPs Table
CREATE TABLE public.rsvps (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  guest_name TEXT NOT NULL,
  phone TEXT,
  attending TEXT NOT NULL CHECK (attending IN ('yes', 'no')),
  guest_count INTEGER DEFAULT 1,
  dietary TEXT,
  message TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Create Event Photos Table
CREATE TABLE public.event_photos (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  image_url TEXT NOT NULL,
  phase TEXT NOT NULL CHECK (phase IN ('before', 'during', 'after')),
  caption TEXT,
  uploaded_by TEXT DEFAULT 'Guest',
  likes INTEGER DEFAULT 0,
  is_approved BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. Row Level Security Policies
ALTER TABLE public.rsvps ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.event_photos ENABLE ROW LEVEL SECURITY;

-- Allow public guests to view approved photos and submit RSVPs
CREATE POLICY "Public Read Approved Photos" ON public.event_photos 
  FOR SELECT USING (is_approved = true);

CREATE POLICY "Public Insert Photos" ON public.event_photos 
  FOR INSERT WITH CHECK (true);

CREATE POLICY "Public Insert RSVPs" ON public.rsvps 
  FOR INSERT WITH CHECK (true);`}</pre>
              </div>

              <div className="p-3 rounded-xl border bg-black/20 text-[11px]" style={{ borderColor: theme.colors.border }}>
                <strong className="text-white block mb-1">Self-Contained Ready:</strong>
                This application already includes embedded state fallbacks and local storage simulation, so guests can RSVP and upload photos immediately without missing a beat!
              </div>
            </div>

            <div className="mt-6 text-right">
              <button
                onClick={() => setIsSchemaModalOpen(false)}
                className="px-5 py-2 rounded-xl text-xs font-semibold"
                style={{ backgroundColor: theme.colors.primary, color: theme.colors.primaryText }}
              >
                Got It
              </button>
            </div>
          </div>
        </div>
      )}

      {}
      <div className="fixed bottom-6 right-6 z-40">
        <button
          onClick={toggleAudio}
          className="group flex items-center gap-3 px-4 py-3 rounded-full border backdrop-blur-xl shadow-2xl transition-all duration-300 hover:scale-105 active:scale-95"
          style={{
            backgroundColor: `${theme.colors.surface}ee`,
            borderColor: theme.colors.border,
            boxShadow: theme.colors.goldGlow
          }}
          title={isPlayingAudio ? 'Mute Background Music' : 'Play Romantic Atmosphere'}
        >
          {/* Animated Equalizer Bars */}
          <div className="flex items-end gap-1 h-4 w-4 justify-center">
            {isPlayingAudio ? (
              <>
                <span className="w-1 bg-amber-400 rounded-full animate-bounce h-3" />
                <span className="w-1 bg-amber-400 rounded-full animate-bounce h-4 delay-100" />
                <span className="w-1 bg-amber-400 rounded-full animate-bounce h-2 delay-200" />
              </>
            ) : (
              <Music className="w-4 h-4" style={{ color: theme.colors.primary }} />
            )}
          </div>

          <div className="text-left hidden sm:block">
            <p className="text-[10px] tracking-wider uppercase font-semibold" style={{ color: theme.colors.primary }}>
              {isPlayingAudio ? 'Ambient Soundscape' : 'Ambiance Audio'}
            </p>
            <p className="text-[9px] opacity-70">
              {isPlayingAudio ? 'Now Playing' : 'Click to Listen'}
            </p>
          </div>

          <div 
            className="w-6 h-6 rounded-full flex items-center justify-center border"
            style={{ borderColor: theme.colors.border, color: theme.colors.primary }}
          >
            {isPlayingAudio ? <Volume2 className="w-3.5 h-3.5" /> : <VolumeX className="w-3.5 h-3.5 opacity-60" />}
          </div>
        </button>
      </div>

      {}
      <footer 
        className="border-t py-12 px-4 text-center relative z-10 text-xs"
        style={{
          borderColor: theme.colors.border,
          backgroundColor: theme.colors.surface
        }}
      >
        <div className="max-w-2xl mx-auto space-y-4">
          <p className={`text-2xl font-serif ${theme.fontHeading}`} style={{ color: theme.colors.accent }}>
            {eventDetails.hosts}
          </p>
          <p className="font-light leading-relaxed opacity-75" style={{ color: theme.colors.textMuted }}>
            With gratitude to our families, friends, and loved ones traveling from near and far. We cherish your presence in celebrating our forever beginning.
          </p>
          <div className="pt-4 text-[11px] opacity-50 flex items-center justify-center gap-1">
            <span>Udaipur • 2026 • Crafted with</span>
            <Heart className="w-3 h-3 fill-rose-400 text-rose-400 inline" />
          </div>
        </div>
      </footer>
    </div>
  );
}
